# Скопируйте в .env для локальной разработки. В production — переменные окружения платформы.
ENV=development
PORT=8000
WEB_CONCURRENCY=2

JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# Через запятую. Адрес фронта для CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL — USE_DB=1 включает репозиторий вместо in-memory.
# USE_DB=auto: PostgreSQL в production при наличии DATABASE_URL.
USE_DB=auto
# DATABASE_URL=postgresql+psycopg://urban:urban@localhost:5432/urban_city
# Supabase: для API лучше Transaction pooler (:6543), не Session (:5432).
# Пример: ...@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# DB_POOL_MODE=auto        # auto|transaction|session
# DB_POOL_SIZE=3           # только для session/прямого Postgres
# DB_POOL_TIMEOUT=30
# RUN_MIGRATIONS=1

# Демо-дата (совпадает с фронтом).
DEMO_TODAY=2026-07-02

# Cloudflare R2 (S3 API). Bucket: frm-urban-city
# Spec endpoint обычно: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=frm-urban-city
R2_REGION=auto
# Если бакет публичный (r2.dev / свой домен) — стабильный url без подписи.
# Если пусто — в БД кладётся object key, а GET /photos отдаёт SigV4 presigned URL (~1ч).
R2_PUBLIC_BASE_URL=
# TTL подписанных GET URL (секунды), по умолчанию 3600
# R2_PRESIGN_TTL_SECONDS=3600
# Опционально: Cloudflare API Token (для S3 put не нужен)
# R2_API_TOKEN=
# R2_REQUIRED=1
