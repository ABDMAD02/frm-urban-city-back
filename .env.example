# Скопируйте в .env для локальной разработки. В production — переменные окружения платформы.
ENV=development
PORT=8000
WEB_CONCURRENCY=2

JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14

# Через запятую. Адрес фронта для CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL — USE_DB=1 включает репозиторий вместо in-memory.
# USE_DB=auto: PostgreSQL в production при наличии DATABASE_URL.
USE_DB=auto
# DATABASE_URL=postgresql+psycopg://urban:urban@localhost:5432/urban_city
# RUN_MIGRATIONS=1

# Демо-дата (совпадает с фронтом).
DEMO_TODAY=2026-07-02
